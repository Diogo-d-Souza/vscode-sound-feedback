# Dependências instaladas localmente
node_modules/

# Saída gerada pelo TypeScript e pacotes empacotados da extensão
out/
*.vsix
*.vsix.*

# Logs e arquivos de diagnóstico de gerenciadores de pacotes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Relatórios e artefatos de testes
coverage/
test-results/

# Arquivos temporários do sistema operacional e editores
.DS_Store
Thumbs.db
*.tmp
*.temp
*.swp
*.swo

# Configurações locais e segredos
.env
.env.*
!.env.example

# Estado pessoal do VS Code. As tarefas e configurações de execução do
# projeto (.vscode/tasks.json e .vscode/launch.json) continuam versionadas.
**/.vscode/settings.json
**/.vscode/*.local.json
