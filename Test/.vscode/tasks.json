          "message": 5
        }
      }
    },
    {
      "label": "T04 - Corrigir o warning",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/diagnostic-test.js", "t04"],
      "problemMatcher": {
        "owner": "diagnostic-audio-test",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (error|warning): (.*)$",
          "file": 1,
